      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "node",
                "manufacturer",
                "product",
                "cpu_model",
                "firmware",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "node": 0,
              "Value #C": 1,
              "manufacturer": 2,
              "product": 3,
              "cpu_model": 4,
              "Value #G": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #F": 8,
              "firmware": 9
