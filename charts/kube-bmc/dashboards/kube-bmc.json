              "manufacturer": "Vendor",
              "product": "Model",
              "cpu_model": "CPU",
              "firmware": "BMC firmware",
              "Value #C": "Health",
              "Value #D": "Power",
              "Value #E": "Inlet",
              "Value #F": "SEL used",
              "Value #G": "GPUs"
            }
